---
import chung from '../data/chung.json';

// ngayDangISO / ngaySuaISO: trang bài blog truyền vào để khai báo ngày giờ đăng và
// ngày giờ sửa gần nhất cho Google, Zalo, Facebook. Trang thường thì bỏ trống.
const { title, description, path = '/', image, ngayDangISO, ngaySuaISO } = Astro.props;
const siteUrl = 'https://timhangxetai.com';
const fullTitle = title || 'Tìm Hàng Xe Tải — Sàn kết nối chủ hàng và nhà xe tải toàn quốc';
const fullDesc = description || 'Chủ hàng đăng chuyến, nhà xe báo giá và nhận đơn — hai bên tự thoả thuận, tự thanh toán trực tiếp. Miễn phí cho chủ hàng, trải nghiệm ngay với đơn hàng thật.';
// Ảnh mặc định khi chia sẻ link lên Zalo/Facebook: logo timhangxetai.com đặt giữa nền trắng
// 1200x630 (tỉ lệ khung xem trước của Zalo/Facebook, logo vuông để trần sẽ bị cắt mất chữ).
// Bài blog truyền `image` riêng thì vẫn dùng ảnh bài.
const ogImage = siteUrl + (image || '/anh/og-timhangxetai.jpg');
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<script>
  /* Ai đã cài app vào máy (icon ngoài màn hình) thì nhảy thẳng qua app thật, không xem trang
     giới thiệu — đúng cơ chế chuxetai.com đang dùng. */
  (function(){
    try{
      var laAppDaCai = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true;
      if (laAppDaCai) { location.replace('https://app.timhangxetai.com/'); }
    }catch(e){}
  })();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={fullDesc}>
<meta name="theme-color" content="#0a1642">
<meta name="google-site-verification" content="oSd56LSOQs7h_LZoo0nH-If322vcO6uL-yUa7aR1PnU" />
<meta name="zalo-platform-site-verification" content="HF-Q4AR_3IHcwzulXjfk5GNInH3ff15BD3Gn" />
<link rel="canonical" href={siteUrl + path}>
<link rel="icon" href="/anh/favicon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/anh/6.png">
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={fullDesc}>
<meta property="og:url" content={siteUrl + path}>
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={fullDesc}>
<meta name="twitter:image" content={ogImage}>
{ngayDangISO && <meta property="article:published_time" content={ngayDangISO} />}
{ngaySuaISO && <meta property="article:modified_time" content={ngaySuaISO} />}
{ngayDangISO && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: fullTitle,
    description: fullDesc,
    image: ogImage,
    datePublished: ngayDangISO,
    dateModified: ngaySuaISO || ngayDangISO,
    publisher: { '@type': 'Organization', name: 'Tìm Hàng Xe Tải', url: siteUrl },
    mainEntityOfPage: siteUrl + path,
  })} />
)}
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tìm Hàng Xe Tải',
  url: siteUrl,
  description: 'Sàn kết nối chủ hàng và nhà xe tải khắp Việt Nam.',
  areaServed: 'VN'
})} />
{chung.fbPixelId && (
  <script is:inline define:vars={{ pixelId: chung.fbPixelId }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', pixelId); fbq('track', 'PageView');
  </script>
)}
{chung.gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${chung.gaId}`}></script>
    <script is:inline define:vars={{ gaId: chung.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
<style is:global>
  :root{
    --bg:#eef1f7; --panel:#ffffff; --card:#ffffff; --line:#e4e8f2;
    --text:#0b1233; --text-soft:#33405e; --muted:#6b7793;
    --accent:#eb3309; --accent-dark:#b02607; --accent-tint:#fff1ec;
    --navy:#0a1642; --navy2:#060e2b;
    --green:#12833f; --green-tint:#e9f7ee;
    --amber:#b5730a; --amber-tint:#fff4dd; --amber-line:#f2c65a;
    --blue:#2f5fd6; --blue-tint:#eaf0ff;
    --shadow:0 1px 2px rgba(10,22,66,.06),0 8px 30px rgba(10,22,66,.08);
    --radius:14px;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --bg:#080d1c; --panel:#0d1330; --card:#12224f; --line:rgba(255,255,255,.12);
      --text:#eef2ff; --text-soft:#c7d2ec; --muted:#95a6cf;
      --accent:#ff5a2b; --accent-dark:#ff7d55; --accent-tint:#2a140d;
      --green:#26c281; --green-tint:#123720;
      --amber:#f5b301; --amber-tint:#2a2206; --amber-line:#5a4a12;
      --blue:#4b8bff; --blue-tint:#132449;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 34px rgba(0,0,0,.45);
    }
  }
  :root[data-theme="dark"]{
    --bg:#080d1c; --panel:#0d1330; --card:#12224f; --line:rgba(255,255,255,.12);
    --text:#eef2ff; --text-soft:#c7d2ec; --muted:#95a6cf;
    --accent:#ff5a2b; --accent-dark:#ff7d55; --accent-tint:#2a140d;
    --green:#26c281; --green-tint:#123720;
    --amber:#f5b301; --amber-tint:#2a2206; --amber-line:#5a4a12;
    --blue:#4b8bff; --blue-tint:#132449;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 34px rgba(0,0,0,.45);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    line-height:1.6; -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1120px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  img{max-width:100%}
  :focus-visible{outline:2px solid var(--accent); outline-offset:2px}
  [data-edit]{cursor:text}
  [data-edit-img]{cursor:pointer}
</style>
</head>
<body>
  {/* Mảnh cuối của đoạn mã Meta Pixel: đếm cả khách TẮT JavaScript (đoạn script ở <head> lo phần
     còn lại). Facebook đặt thẻ này ngay sau script, nhưng <img> không hợp lệ trong <head> nên đặt
     đầu <body> — tác dụng y hệt. */}
  {chung.fbPixelId && (
    <noscript>
      <img height="1" width="1" style="display:none" alt=""
        src={`https://www.facebook.com/tr?id=${chung.fbPixelId}&ev=PageView&noscript=1`} />
    </noscript>
  )}
  <slot />
  {chung.contactForm && (
    <div id="popupLienHe" style="display:none"></div>
  )}
  <script is:inline>
    /* PWA: đăng ký service worker + nút "Tải ứng dụng" cài ra màn hình.
       Không trình duyệt nào cho phép TỰ ghim không hỏi — nút này hiện hộp Cài đặt
       (Android/Chrome) hoặc hướng dẫn 2 bước (iPhone/Safari). */
    (function () {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
      var deferred = null;
      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        deferred = e;
      });
      function laIOS() {
        return /iphone|ipad|ipod/i.test(navigator.userAgent) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      }
      function daCai() {
        return (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) ||
          window.navigator.standalone === true;
      }
      // Nhớ đã nhắc cài trên máy này chưa — chỉ nhắc lại sau 14 ngày, đừng làm phiền.
      function daNhacCai() {
        try { return Number(localStorage.getItem('thxt_nhac_cai') || 0) > Date.now() - 14 * 864e5; }
        catch (e) { return false; }
      }
      function ghiNhacCai() {
        try { localStorage.setItem('thxt_nhac_cai', String(Date.now())); } catch (e) {}
      }
      // tiepTuc: dia chi mo tiep sau khi nguoi dung dong huong dan (de khong can duong ho vao app)
      function huongDanIOS(tiepTuc) {
        var o = document.getElementById('caiAppGuide');
        if (o) {
          o.setAttribute('data-tiep', tiepTuc || '');
          var nutCu = o.querySelector('#caiAppClose');
          if (nutCu) nutCu.textContent = tiepTuc ? 'Đã hiểu, vào app' : 'Đã hiểu';
          o.style.display = 'flex';
          return;
        }
        o = document.createElement('div');
        o.id = 'caiAppGuide';
        o.setAttribute('data-tiep', tiepTuc || '');
        o.style.cssText = 'position:fixed;inset:0;background:rgba(6,14,43,.72);z-index:99999;display:flex;align-items:flex-end;justify-content:center;padding:16px';
        o.innerHTML =
          '<div style="background:#fff;color:#0b1233;max-width:440px;width:100%;border-radius:18px;padding:20px;font-family:inherit;box-shadow:0 20px 60px rgba(0,0,0,.4)">' +
          '<div style="display:flex;align-items:center;gap:10px;margin-bottom:12px"><img src="/anh/icon.svg" style="width:42px;height:42px;border-radius:10px"><b style="font-size:16px">Cài Tìm Hàng Xe Tải ra màn hình</b></div>' +
          '<p style="margin:0 0 8px;color:#33405e;font-size:14.5px">Trên iPhone/iPad, làm 2 bước:</p><ol style="margin:0 0 4px 18px;color:#33405e;font-size:14.5px;line-height:1.75"><li>Bấm nút <b>Chia sẻ</b> (ô vuông có mũi tên) ở thanh Safari.</li><li>Chọn <b>“Thêm vào Màn hình chính”</b>.</li></ol>' +
          '<div style="text-align:right;margin-top:16px"><button id="caiAppClose" style="background:#eb3309;color:#fff;border:0;border-radius:10px;font-weight:800;font-size:14.5px;padding:10px 18px;cursor:pointer">Đã hiểu</button></div>' +
          '</div>';
        document.body.appendChild(o);
        var nut = o.querySelector('#caiAppClose');
        if (nut && tiepTuc) nut.textContent = 'Đã hiểu, vào app';
        o.addEventListener('click', function (ev) {
          if (ev.target !== o && ev.target.id !== 'caiAppClose') return;
          o.style.display = 'none';
          var tiep = o.getAttribute('data-tiep');
          if (tiep) { o.setAttribute('data-tiep', ''); location.href = tiep; }
        });
      }
      document.addEventListener('click', function (e) {
        var b = e.target.closest('#btnCaiApp, .js-cai-app');
        if (b) {
          // NÚT "TẢI ỨNG DỤNG":
          // 1) Android/Chrome đủ điều kiện: bật hộp Cài đặt của máy (1 chạm ra icon)
          if (deferred) {
            e.preventDefault();
            deferred.prompt();
            deferred.userChoice.finally(function () { deferred = null; });
            return;
          }
          // 2) iPhone/iPad (chưa cài): Apple bắt buộc làm tay, hiện hướng dẫn 2 bước
          if (laIOS() && !daCai()) {
            e.preventDefault();
            huongDanIOS();
            return;
          }
          // 3) Còn lại (máy tính, hoặc đã cài): để nút mở thẳng app — không chặn
          return;
        }
        // MỌI NÚT HÀNH ĐỘNG MỞ APP (Đăng hàng, Trải nghiệm, Tôi cần thuê xe, Đăng nhập...):
        // gắn lời mời cài trước, rồi vẫn vào app để không cản trở việc của khách.
        var a = e.target.closest('a');
        if (a && a.href && a.href.indexOf('app.timhangxetai.com') >= 0) {
          // 1) Android/Chrome du dieu kien: bat hop Cai dat cua may, xong moi vao app
          if (deferred) {
            e.preventDefault();
            var href = a.href;
            ghiNhacCai();
            deferred.prompt();
            deferred.userChoice.finally(function () { deferred = null; location.href = href; });
            return;
          }
          // 2) iPhone/iPad chua cai: Apple khong cho bat hop cai -> hien huong dan 2 buoc,
          //    bam "Da hieu, vao app" la di tiep. Chi nhac lai sau 14 ngay.
          if (laIOS() && !daCai() && !daNhacCai()) {
            e.preventDefault();
            ghiNhacCai();
            huongDanIOS(a.href);
            return;
          }
          // 3) Con lai (may tinh, hoac da cai): mo app binh thuong — khong chan
        }
      });
    })();
  </script>
</body>
</html>
