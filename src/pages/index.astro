---
import Layout from '../layouts/Layout.astro';
import t from '../data/trangchu.json';

const appUrl = t.appUrl || 'https://app.timhangxetai.com/';
---
<Layout path="/">

<header class="site-head">
  <div class="wrap bar">
    <a class="brand-logo" href="/"><span class="brand-mark">🚚</span><span>Tìm hàng<span style="color:var(--accent)"> xe tải</span></span></a>
    <nav class="nav-links" aria-label="Menu chính">
      <span class="navdrop">
        <a href="/blog/">Dịch vụ <span class="car">▾</span></a>
        <div class="mega">
          <div class="mtop"><span class="pill dv">DỊCH VỤ</span><span class="kw">Dịch vụ vận chuyển theo tuyến &amp; khu vực</span></div>
          <div class="mlist">
            <a class="it" href="/blog/thue-xe-tai-cho-hang-di-tinh-can-luu-y-gi/"><span class="bt dv"></span>Thuê xe tải chở hàng đi tỉnh cần lưu ý gì</a>
            <a class="it" href="/blog/thue-xe-tai-cho-hang-bac-nam-ghep-hang-hay-bao-xe/"><span class="bt dv"></span>Thuê xe tải chở hàng Bắc Nam: ghép hay bao xe</a>
            <a class="mall dv" href="/blog/">Xem tất cả Dịch vụ →</a>
          </div>
        </div>
      </span>
      <span class="navdrop">
        <a href="/blog/">Cách tìm hàng <span class="car">▾</span></a>
        <div class="mega">
          <div class="mtop"><span class="pill tim">CÁCH TÌM HÀNG</span><span class="kw">Kinh nghiệm cho chủ xe tải</span></div>
          <div class="mlist">
            <a class="it" href="/blog/nha-xe-tim-hang-o-dau/"><span class="bt tim"></span>Nhà xe tìm hàng ở đâu để xe ít chạy rỗng</a>
            <a class="it" href="/blog/vi-sao-xe-chay-rong-chieu-ve/"><span class="bt tim"></span>Vì sao xe chạy rỗng chiều về &amp; cách tìm hàng 2 chiều</a>
            <a class="mall tim" href="/blog/">Xem tất cả Cách tìm hàng →</a>
          </div>
        </div>
      </span>
      <span class="navdrop rt">
        <a href="/blog/">Kinh nghiệm đặt xe <span class="car">▾</span></a>
        <div class="mega">
          <div class="mtop"><span class="pill dat">KINH NGHIỆM ĐẶT XE</span><span class="kw">Hướng dẫn chủ hàng đặt xe, chọn nhà xe uy tín</span></div>
          <div class="mlist">
            <a class="it" href="/blog/cach-chon-nha-xe-uy-tin-khi-thue-lan-dau/"><span class="bt dat"></span>Cách chọn nhà xe uy tín khi thuê lần đầu</a>
            <a class="it" href="/blog/cach-tinh-cuoc-van-chuyen-hang-hoa/"><span class="bt dat"></span>Cách tính cước vận chuyển hàng hóa</a>
            <a class="it" href="/blog/cach-dong-goi-hang-hoa-khi-gui-xe-tai/"><span class="bt dat"></span>Cách đóng gói hàng hóa an toàn khi gửi xe</a>
            <a class="it" href="/blog/gui-hang-qua-nha-xe-hay-chanh-xe/"><span class="bt dat"></span>Gửi hàng qua nhà xe hay chành xe</a>
            <a class="it" href="/blog/van-chuyen-hang-hoa-can-giay-to-gi/"><span class="bt dat"></span>Vận chuyển hàng hóa cần giấy tờ gì</a>
            <a class="it" href="/blog/xe-tai-may-tan-cho-duoc-bao-nhieu-hang/"><span class="bt dat"></span>Xe tải mấy tấn chở được bao nhiêu hàng</a>
            <a class="mall dat" href="/blog/">Xem tất cả Kinh nghiệm đặt xe →</a>
          </div>
        </div>
      </span>
    </nav>
    <div class="nav-cta">
      <a class="login" href={appUrl}>Đăng nhập</a>
      <a class="btn js-cai-app" id="btnCaiApp" href={appUrl}>Tải ứng dụng</a>
      <button class="burger" aria-label="Mở menu" id="burgerBtn">☰</button>
    </div>
  </div>
  <nav class="m-menu" id="mMenu" aria-label="Menu điện thoại">
    <a href="/blog/" class="m-sub"><span class="sq dv"></span>Dịch vụ</a>
    <a href="/blog/" class="m-sub"><span class="sq tim"></span>Cách tìm hàng</a>
    <a href="/blog/" class="m-sub"><span class="sq dat"></span>Kinh nghiệm đặt xe</a>
    <a href={appUrl}>Đăng nhập</a>
  </nav>
</header>

<div class="wrap">

  <div class="hero">
    <div class="hero-in">
      <span class="eyebrow" data-edit="t:eyebrow">{t.eyebrow}</span>
      <h1 data-edit="t:heroH1">{t.heroH1}</h1>
      <p class="lead" data-edit="t:heroLead">{t.heroLead}</p>

      <div class="role-grid">
        {t.roleCards.map((rc, i) => (
          <div class="role-card">
            <div class="r-ico" data-edit={`t:roleCards.${i}.ico`}>{rc.ico}</div>
            <h2 data-edit={`t:roleCards.${i}.title`}>{rc.title}</h2>
            <p data-edit={`t:roleCards.${i}.desc`}>{rc.desc}</p>
            {/* Thẻ nhà xe (i=1) dẫn sang trang bán hàng /nha-xe trước khi vào app;
               thẻ chủ hàng (i=0) vẫn vào thẳng app như cũ. */}
            <a class="btn-lg primary" href={i === 1 ? "/nha-xe/" : appUrl} data-edit={`t:roleCards.${i}.btn`}>{rc.btn}</a>
          </div>
        ))}
      </div>

      <div class="bonus-band">
        <span class="b-ico" data-edit="t:bonus.ico">{t.bonus.ico}</span>
        <div class="b-txt">
          <b data-edit="t:bonus.title">{t.bonus.title}</b>
          <span data-edit="t:bonus.desc">{t.bonus.desc}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="strip">
    <div class="chips">
      {t.chips.map((c, i) => <span class="chip" data-edit={`t:chips.${i}`}>{c}</span>)}
    </div>
  </div>

  <section>
    <div class="sec-h">
      <span class="tag" data-edit="t:ketQua.tag">{t.ketQua.tag}</span>
      <h2 data-edit="t:ketQua.h2">{t.ketQua.h2}</h2>
    </div>
    <div class="prose">
      <p><b>{t.ketQua.labelChuHang}</b> <span data-edit="t:ketQua.textChuHang">{t.ketQua.textChuHang}</span></p>
      <p><b>{t.ketQua.labelNhaXe}</b> <span data-edit="t:ketQua.textNhaXe">{t.ketQua.textNhaXe}</span></p>
      <p data-edit="t:ketQua.ketLuan">{t.ketQua.ketLuan}</p>
    </div>
  </section>

  <section>
    <div class="sec-h">
      <span class="tag" data-edit="t:luonDiKem.tag">{t.luonDiKem.tag}</span>
      <h2 data-edit="t:luonDiKem.h2">{t.luonDiKem.h2}</h2>
    </div>
    <div class="cred">
      {t.luonDiKem.items.map((it, i) => (
        <div class="c-card">
          <div class={`c-ico ${['a','g','b'][i % 3]}`} data-edit={`t:luonDiKem.items.${i}.ico`}>{it.ico}</div>
          <h3 data-edit={`t:luonDiKem.items.${i}.title`}>{it.title}</h3>
          <p data-edit={`t:luonDiKem.items.${i}.desc`}>{it.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="loiich">
    <div class="sec-h">
      <span class="tag" data-edit="t:loiIch.tag">{t.loiIch.tag}</span>
      <h2 data-edit="t:loiIch.h2">{t.loiIch.h2}</h2>
    </div>
    <div class="cred">
      {t.loiIch.items.map((it, i) => (
        <div class="c-card">
          <div class={`c-ico ${['a','g','b'][i % 3]}`} data-edit={`t:loiIch.items.${i}.ico`}>{it.ico}</div>
          <h3 data-edit={`t:loiIch.items.${i}.title`}>{it.title}</h3>
          <p data-edit={`t:loiIch.items.${i}.desc`}>{it.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="cachlam">
    <div class="sec-h">
      <span class="tag" data-edit="t:cachHoatDong.tag">{t.cachHoatDong.tag}</span>
      <h2 data-edit="t:cachHoatDong.h2">{t.cachHoatDong.h2}</h2>
    </div>
    <div class="how-split">
      <div class="how-col buyer">
        <div class="h-head"><span class="h-ico">📦</span><h3 data-edit="t:cachHoatDong.buyer.title">{t.cachHoatDong.buyer.title}</h3></div>
        <ol>
          {t.cachHoatDong.buyer.steps.map((s, i) => (
            <li><span class="st-n">{i + 1}</span><span class="st-t"><b>{s.label}</b> — <span data-edit={`t:cachHoatDong.buyer.steps.${i}.desc`}>{s.desc}</span></span></li>
          ))}
        </ol>
      </div>
      <div class="how-col carrier">
        <div class="h-head"><span class="h-ico">🚚</span><h3 data-edit="t:cachHoatDong.carrier.title">{t.cachHoatDong.carrier.title}</h3></div>
        <ol>
          {t.cachHoatDong.carrier.steps.map((s, i) => (
            <li><span class="st-n">{i + 1}</span><span class="st-t"><b>{s.label}</b> — <span data-edit={`t:cachHoatDong.carrier.steps.${i}.desc`}>{s.desc}</span></span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section>
    <div class="sec-h">
      <span class="tag" data-edit="t:hopVoiAi.tag">{t.hopVoiAi.tag}</span>
      <h2 data-edit="t:hopVoiAi.h2">{t.hopVoiAi.h2}</h2>
    </div>
    <div class="who-split">
      <div class="who-col">
        <h3 data-edit="t:hopVoiAi.chuHang.label">{t.hopVoiAi.chuHang.label}</h3>
        {t.hopVoiAi.chuHang.items.map((it, i) => (
          <div class="w"><b>{it.b}</b> — <span data-edit={`t:hopVoiAi.chuHang.items.${i}.rest`}>{it.rest}</span></div>
        ))}
      </div>
      <div class="who-col">
        <h3 data-edit="t:hopVoiAi.nhaXe.label">{t.hopVoiAi.nhaXe.label}</h3>
        {t.hopVoiAi.nhaXe.items.map((it, i) => (
          <div class="w"><b>{it.b}</b> — <span data-edit={`t:hopVoiAi.nhaXe.items.${i}.rest`}>{it.rest}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="mission">
      <blockquote data-edit="t:mission.quote">{t.mission.quote}</blockquote>
      <cite data-edit="t:mission.cite">{t.mission.cite}</cite>
    </div>
  </section>

  <section id="hoidap">
    <div class="sec-h">
      <span class="tag" data-edit="t:faq.tag">{t.faq.tag}</span>
      <h2 data-edit="t:faq.h2">{t.faq.h2}</h2>
    </div>
    <div class="faq">
      {t.faq.items.map((f, i) => (
        <details open={i === 0}>
          <summary data-edit={`t:faq.items.${i}.q`}>{f.q}</summary>
          <div class="a" data-edit={`t:faq.items.${i}.a`}>{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <section style="padding-top:0">
    <div class="momentum" data-edit="t:momentum">{t.momentum}</div>
  </section>

  <section>
    <div class="final">
      <h2 data-edit="t:finalCta.h2">{t.finalCta.h2}</h2>
      <p data-edit="t:finalCta.p">{t.finalCta.p}</p>
      <div class="hero-cta">
        <a class="btn-lg primary" href={appUrl} data-edit="t:finalCta.btn1">{t.finalCta.btn1}</a>
        <a class="btn-lg ghost" href={appUrl} data-edit="t:finalCta.btn2">{t.finalCta.btn2}</a>
      </div>
    </div>
  </section>

</div>

<footer class="site-foot">
  <div class="wrap f-grid">
    <div class="f-col">
      <a class="brand-logo" href="/"><span class="brand-mark">🚚</span><span>Tìm hàng<span style="color:var(--accent)"> xe tải</span></span></a>
      <p class="f-desc">Sàn kết nối chủ hàng và nhà xe tải khắp Việt Nam. Đăng chuyến, báo giá, chốt xe — nhanh gọn mỗi ngày.</p>
    </div>
    <div class="f-col">
      <h4>Sản phẩm</h4>
      <a href="#loiich">Lợi ích</a>
      <a href="#cachlam">Cách hoạt động</a>
      <a href="#hoidap">Hỏi nhanh</a>
    </div>
    <div class="f-col">
      <h4>Tài khoản</h4>
      <a href={appUrl}>Đăng nhập</a>
      <a href={appUrl}>Trải nghiệm ngay</a>
    </div>
  </div>
  <div class="f-legal">© 2026 Tìm Hàng Xe Tải — Sàn kết nối chủ hàng &amp; nhà xe tải toàn quốc.</div>
</footer>

<style>
  .site-head{position:sticky; top:0; z-index:30; background:var(--panel); border-bottom:1px solid var(--line)}
  .site-head .bar{display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 20px}
  .brand-logo{display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:-.01em; font-size:18px; text-decoration:none}
  .brand-mark{width:34px; height:34px; border-radius:10px; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:17px; box-shadow:0 4px 12px rgba(235,51,9,.35); flex:0 0 auto}
  .nav-links{display:flex; align-items:center; gap:15px; font-size:14px; font-weight:700}
  .nav-links>a,.navdrop>a{text-decoration:none; color:var(--text-soft); white-space:nowrap; display:inline-flex; align-items:center; gap:5px}
  .nav-links>a:hover,.navdrop:hover>a{color:var(--accent-dark)}
  .navdrop{position:relative; display:flex; align-items:center}
  .navdrop>a .car{font-size:9px; opacity:.7; transition:transform .2s}
  .navdrop:hover>a .car{transform:rotate(180deg)}
  .mega{position:absolute; top:calc(100% + 14px); left:0; width:334px; background:var(--panel); border:1px solid var(--line); border-radius:15px; box-shadow:0 20px 46px rgba(10,22,66,.18); opacity:0; visibility:hidden; transform:translateY(8px); transition:.16s; overflow:hidden; z-index:40}
  .navdrop.rt .mega{left:auto; right:0}
  .navdrop:hover .mega{opacity:1; visibility:visible; transform:translateY(0)}
  .mega .mtop{padding:14px 16px 10px; border-bottom:1px solid var(--line)}
  .mega .pill{display:inline-block; font-size:11px; color:#fff; padding:3px 10px; border-radius:999px; font-weight:800; letter-spacing:.3px}
  .mega .pill.dv{background:var(--blue)} .mega .pill.tim{background:var(--accent)} .mega .pill.dat{background:var(--green)}
  .mega .kw{display:block; margin-top:7px; font-size:12px; color:var(--muted); font-weight:600}
  .mega .mlist{padding:8px}
  .mega a.it{display:flex; gap:9px; align-items:flex-start; padding:8px 9px; border-radius:9px; font-size:13.6px; font-weight:700; color:var(--text-soft); line-height:1.34; text-decoration:none}
  .mega a.it:hover{background:var(--bg); color:var(--text)}
  .mega a.it .bt{width:7px; height:7px; border-radius:50%; margin-top:6px; flex:none}
  .mega .bt.dv{background:var(--blue)} .mega .bt.tim{background:var(--accent)} .mega .bt.dat{background:var(--green)}
  .mega a.mall{display:block; text-align:center; font-weight:800; font-size:12.5px; padding:11px; color:#fff; margin:6px 8px 10px; border-radius:9px; text-decoration:none}
  .mega a.mall.dv{background:var(--blue)} .mega a.mall.tim{background:var(--accent)} .mega a.mall.dat{background:var(--green)}
  .m-menu .m-cat{display:block; padding:12px 4px 4px; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--muted)}
  .m-menu .m-sub{padding-left:8px; display:flex; align-items:center; gap:9px}
  .m-menu .sq{width:9px; height:9px; border-radius:3px; flex:none}
  .m-menu .sq.dv{background:var(--blue)} .m-menu .sq.tim{background:var(--accent)} .m-menu .sq.dat{background:var(--green)}
  .nav-cta{display:flex; align-items:center; gap:14px}
  .nav-cta .login{text-decoration:none; color:var(--text-soft); font-size:14.5px; font-weight:700}
  .nav-cta .login:hover{color:var(--accent-dark)}
  .nav-cta .btn{background:var(--accent); color:#fff; text-decoration:none; font-size:14.5px; font-weight:800; padding:9px 16px; border-radius:10px}
  .nav-cta .btn:hover{background:var(--accent-dark)}
  .burger{display:none; appearance:none; background:transparent; border:1px solid var(--line); border-radius:9px; width:38px; height:38px; place-items:center; cursor:pointer; color:var(--text); font-size:18px}
  .m-menu{display:none; border-top:1px solid var(--line); padding:10px 20px 14px}
  .m-menu a{display:block; padding:9px 4px; text-decoration:none; color:var(--text-soft); font-weight:700; font-size:15px}
  .m-menu.open{display:block}
  @media(max-width:820px){ .nav-links{display:none} .nav-cta .login{display:none} .burger{display:grid} }

  .btn-lg{display:inline-block; text-decoration:none; font-weight:800; font-size:15.5px; padding:13px 22px; border-radius:12px; transition:.18s; text-align:center}
  .btn-lg.primary{background:var(--accent); color:#fff; box-shadow:0 8px 22px rgba(235,51,9,.35)}
  .btn-lg.primary:hover{background:var(--accent-dark)}
  .btn-lg.ghost{border:2px solid rgba(255,255,255,.35); color:#fff}
  .btn-lg.ghost:hover{background:rgba(255,255,255,.1)}

  .hero{background:linear-gradient(160deg,var(--navy),var(--navy2)); color:#fff; border-radius:22px; padding:46px 28px 34px; position:relative; overflow:hidden; margin-top:22px}
  .hero:before{content:""; position:absolute; right:-90px; top:-90px; width:320px; height:320px; background:radial-gradient(circle,rgba(235,51,9,.36),transparent 68%); pointer-events:none}
  .hero:after{content:""; position:absolute; left:-120px; bottom:-140px; width:320px; height:320px; background:radial-gradient(circle,rgba(245,179,1,.16),transparent 70%); pointer-events:none}
  .hero-in{max-width:760px; margin:0 auto; text-align:center; position:relative; z-index:1}
  .eyebrow{display:inline-block; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:#fff; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); padding:5px 12px; border-radius:999px}
  .hero h1{margin:.6em 0 .35em; font-size:clamp(22px,3.6vw,33px); line-height:1.28; font-weight:800; letter-spacing:.01em; text-transform:uppercase; text-wrap:balance}
  .hero p.lead{margin:0 auto 26px; color:#c7cde8; font-size:clamp(14.5px,1.8vw,16.5px); max-width:56ch}

  .role-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; text-align:left}
  @media(max-width:680px){ .role-grid{grid-template-columns:1fr} }
  .role-card{background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:16px; padding:20px}
  .role-card .r-ico{font-size:26px; margin-bottom:6px}
  .role-card h2{margin:0 0 3px; font-size:16.5px; font-weight:800; color:#fff}
  .role-card p{margin:0 0 14px; color:#b9c1e6; font-size:13.5px}
  .role-card .btn-lg{width:100%; display:block}

  .bonus-band{margin-top:16px; background:var(--accent-tint); border:1px solid var(--amber-line); border-radius:16px; padding:18px 22px; display:flex; align-items:center; gap:16px; flex-wrap:wrap}
  .bonus-band .b-ico{font-size:30px; flex:0 0 auto}
  .bonus-band .b-txt{flex:1; min-width:220px; text-align:left}
  .bonus-band .b-txt b{color:var(--text); font-size:15.5px; display:block; margin-bottom:2px}
  .bonus-band .b-txt span{color:var(--text-soft); font-size:13.5px}

  .strip{padding:24px 0 4px; text-align:center}
  .chips{display:flex; flex-wrap:wrap; gap:9px; justify-content:center}
  .chip{background:var(--card); border:1px solid var(--line); border-radius:999px; padding:7px 15px; font-size:13.3px; font-weight:700; color:var(--text-soft); box-shadow:var(--shadow)}

  section{padding:36px 0}
  .sec-h{text-align:center; max-width:680px; margin:0 auto 24px}
  .sec-h .tag{display:inline-block; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.07em; color:var(--accent-dark); background:var(--accent-tint); padding:4px 12px; border-radius:999px; margin-bottom:10px}
  .sec-h h2{font-size:clamp(19px,2.8vw,26px); font-weight:800; letter-spacing:.01em; text-transform:uppercase; margin:0 0 8px; text-wrap:balance}

  .prose{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:28px 26px; max-width:820px; margin:0 auto}
  .prose p{margin:0 0 14px; color:var(--text-soft); font-size:15.5px}
  .prose p:last-child{margin:0}
  .prose b{color:var(--text)}

  .cred{display:grid; grid-template-columns:repeat(3,1fr); gap:16px}
  @media(max-width:880px){ .cred{grid-template-columns:1fr} }
  .cred .c-card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow)}
