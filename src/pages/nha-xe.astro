  .nx-ru p:last-child{margin-bottom:0}

  /* chừa sẵn chỗ cho thanh dính đáy, không cần :has() */
  .nx-chan{padding:2.2rem 0 5.6rem; color:var(--muted); font-size:.92rem}
  .nx-chan p{margin:0 0 .45rem}

  /* thanh dính đáy */
  .nx-thanh{
    position:fixed; left:0; right:0; bottom:0; z-index:20;
    background:var(--panel); border-top:1px solid var(--line);
    box-shadow:0 -6px 22px rgba(10,22,66,.14);
    padding:.65rem 20px calc(.65rem + env(safe-area-inset-bottom));
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
  }
  .nx-thanh span{font-weight:700; font-size:.98rem; line-height:1.25; color:var(--text-soft)}
  @media(max-width:29rem){
    .nx-thanh span{display:none}
    .nx-thanh{justify-content:center}
    .nx-thanh .nx-nut{width:100%}
  }

  @media (prefers-reduced-motion: reduce){ *{transition:none !important} }
</style>

<script is:inline>
  (function(){
    var g = function(id){ return document.getElementById(id); };
    var oKm = g('nxKm'), oTh = g('nxTieuHao'), oGia = g('nxGia'), oCh = g('nxChuyen');
    if (!oKm) return;
    var kqLit = g('nxKqLit'), kqThang = g('nxKqThang'), kqTien = g('nxKqTien'), dongTien = g('nxDongTien');

    function dinhDang(n){ return n.toLocaleString('vi-VN'); }
    function lay(el){ var v = parseFloat(el.value); return isFinite(v) && v > 0 ? v : 0; }

    function tinh(){
      var lit = lay(oKm) * lay(oTh) / 100;
      var litThang = lit * lay(oCh);
      var gia = lay(oGia);

      kqLit.textContent = lit > 0 ? dinhDang(Math.round(lit)) + ' lít dầu' : '—';
      kqThang.textContent = litThang > 0 ? dinhDang(Math.round(litThang)) + ' lít dầu' : '—';

      if (gia > 0 && litThang > 0) {
        dongTien.hidden = false;
        kqTien.textContent = dinhDang(Math.round(litThang * gia)) + ' đ';
      } else {
        dongTien.hidden = true;
      }
    }

    [oKm, oTh, oGia, oCh].forEach(function(el){ el.addEventListener('input', tinh); });
    tinh();
  })();
</script>

</Layout>
