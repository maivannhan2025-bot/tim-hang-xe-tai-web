  .nx-kiem dl{margin:0; display:grid; gap:.65rem}
  @media(min-width:34rem){.nx-kiem dl{grid-template-columns:9rem 1fr; gap:.65rem 1rem; align-items:baseline}}
  .nx-kiem dt{font-size:.82rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:var(--muted)}
  .nx-kiem dd{margin:0; font-weight:700; font-variant-numeric:tabular-nums}

