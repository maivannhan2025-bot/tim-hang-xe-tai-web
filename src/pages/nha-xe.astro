  .nx-hoi summary::-webkit-details-marker{display:none}
  .nx-hoi summary::after{
    content:"+"; position:absolute; right:.2rem; top:.75rem;
    font-size:1.6rem; font-weight:700; color:var(--accent); line-height:1;
