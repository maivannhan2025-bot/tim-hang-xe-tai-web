  }
  .nx-so-nhat{font-size:1.35rem; color:var(--text)}
  .nx-ghi{padding:0 1.2rem 1.1rem; font-size:.88rem; color:var(--muted); margin:0; line-height:1.55}

  /* lợi ích */
  .nx-loi{margin-top:1.5rem; border-top:1px solid var(--line)}
