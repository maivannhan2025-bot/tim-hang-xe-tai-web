  .nx-tl p{margin:0 0 .8em}
  .nx-tl p:last-child{margin-bottom:0}

  /* chốt */
  .nx-chot{background:var(--navy); color:#fff}
  .nx-chot h2{color:#fff}
  .nx-chot p{color:rgba(255,255,255,.76)}
  .nx-chot .nx-nhan{color:var(--amber-line)}
  .nx-buoc{list-style:none; margin:1.4rem 0 1.6rem; padding:0; counter-reset:b; display:grid; gap:.85rem}
  .nx-buoc li{
    counter-increment:b; position:relative; padding:0 0 .85rem 2.6rem;
