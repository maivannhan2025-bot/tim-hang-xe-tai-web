---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, '');
const { Content } = await render(post);
const ngay = post.data.ngayDang.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
const nhan = post.data.doiTuong === 'chu-hang' ? 'Dành cho chủ hàng' : post.data.doiTuong === 'nha-xe' ? 'Dành cho nhà xe' : 'Dành cho tất cả';
---
<Layout title={post.data.title} description={post.data.description} path={`/blog/${slug}/`} image={post.data.anhDaiDien}>

<header class="site-head">
  <div class="wrap bar">
    <a class="brand-logo" href="/"><span class="brand-mark">🚚</span><span>Tìm hàng<span style="color:var(--accent)"> xe tải</span></span></a>
    <a class="btn" href="https://app.timhangxetai.com/">Trải nghiệm ngay</a>
  </div>
</header>

<div class="wrap narrow">
  <div class="crumb"><a href="/">Trang chủ</a> / <a href="/blog/">Blog</a> / <span>{nhan}</span></div>
  {post.data.anhDaiDien && <img class="anh-dai-dien" src={post.data.anhDaiDien} alt={post.data.title} />}

  <article>
    <span class="cat">{nhan}</span>
    <h1>{post.data.title}</h1>
    <div class="meta">{ngay}{post.data.thoiGianDoc ? ` · Đọc khoảng ${post.data.thoiGianDoc} phút` : ''}</div>
    <div class="body">
      <Content />
    </div>
  </article>

  <div class="cta-box">
    <h3>Trải nghiệm miễn phí, nhận đơn hàng thật ngay hôm nay</h3>
    <a href="https://app.timhangxetai.com/">Vào Tìm Hàng Xe Tải →</a>
  </div>
</div>

<footer class="site-foot">
  <div class="wrap f-legal">© 2026 Tìm Hàng Xe Tải — Sàn kết nối chủ hàng &amp; nhà xe tải toàn quốc.</div>
</footer>

<style>
  .site-head{position:sticky; top:0; z-index:30; background:var(--panel); border-bottom:1px solid var(--line)}
  .site-head .bar{display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 20px}
  .brand-logo{display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:-.01em; font-size:18px; text-decoration:none}
  .brand-mark{width:34px; height:34px; border-radius:10px; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:17px; flex:0 0 auto}
  .btn{background:var(--accent); color:#fff; text-decoration:none; font-size:14.5px; font-weight:800; padding:9px 16px; border-radius:10px}
  .narrow{max-width:760px}
  .crumb{padding:22px 0 0; font-size:13px; color:var(--muted); font-weight:700}
  .crumb a{text-decoration:none; color:var(--muted)}
  .anh-dai-dien{width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:16px; margin-top:16px; box-shadow:var(--shadow)}
  article{padding:14px 0 10px}
  .cat{display:inline-block; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--accent-dark); background:var(--accent-tint); padding:4px 12px; border-radius:999px; margin-bottom:14px}
  article h1{font-size:clamp(24px,4vw,32px); font-weight:800; line-height:1.28; margin:0 0 10px; letter-spacing:-.01em}
  .meta{color:var(--muted); font-size:13.5px; font-weight:600; margin-bottom:24px}
  .body{font-size:16.5px; color:var(--text-soft); line-height:1.75}
  .body :global(h2){font-size:20px; font-weight:800; color:var(--text); margin:32px 0 12px}
  .body :global(p){margin:0 0 18px}
  .body :global(ul){margin:0 0 18px; padding-left:22px}
  .body :global(li){margin-bottom:8px}
  .body :global(blockquote){border-left:3px solid var(--accent); background:var(--card); border-radius:0 12px 12px 0; padding:14px 20px; margin:24px 0; font-size:16px; font-weight:700; color:var(--text)}
  .cta-box{background:var(--card); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); padding:26px; margin:30px 0 40px; text-align:center}
  .cta-box h3{margin:0 0 14px; font-size:18px; font-weight:800}
  .cta-box a{display:inline-block; background:var(--accent); color:#fff; text-decoration:none; font-weight:800; font-size:15px; padding:12px 22px; border-radius:11px}
  .f-legal{padding:20px; text-align:center; color:var(--muted); font-size:12.5px}
  .site-foot{border-top:1px solid var(--line); margin-top:10px}
</style>
</Layout>
